# Electron 国内镜像（GitHub Releases 在国内下载极慢或超时）
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 允许原生模块执行 postinstall（编译 C++ 绑定、下载预编译二进制）
# pnpm v11+ 只从 .npmrc 读取此配置，不再读 package.json 的 pnpm 字段
onlyBuiltDependencies=electron,esbuild,lmdb,msgpackr-extract,uiohook-napi
